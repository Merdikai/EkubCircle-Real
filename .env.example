# ==============================================================================
# EkubCircle — Environment Variables & Connection Configuration Template
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ekubcircle_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ASP.NET Core Connection Strings
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=ekubcircle_db;Username=postgres;Password=your_password_here"
ConnectionStrings__PostgresConnection="Host=localhost;Port=5432;Database=ekubcircle_db;Username=postgres;Password=your_password_here"

# JWT Authentication
Jwt__Key="EkubCircle_Super_Secret_Key_For_Hackathon_2026_Minimum_32_Bytes!"
Jwt__Issuer="EkubCircleAPI"
Jwt__Audience="EkubCircleClient"
Jwt__ExpiryMinutes=1440
