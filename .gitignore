# ==============================================================================
# EkubCircle — Full-Stack Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# .NET / C# Build and Output
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
TestResults/
coverage/
*.coverage
*.coveragexml
*.cdb
*.rpt

# Visual Studio / Rider / Omnisharp
.vs/
.idea/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.DotSettings.user
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Node.js / Angular Frontend
# ------------------------------------------------------------------------------
node_modules/
.angular/
dist/
out-tsc/
bazel-out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Databases (SQLite local files)
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Passwords
# (Keep appsettings.json for default schema, protect environment/production configs)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
appsettings.Production.json
appsettings.Development.json
appsettings.Local.json
*.local.json
!appsettings.Development.example.json
!appsettings.example.json

# ------------------------------------------------------------------------------
# OS and Temporary Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.bak
*~
*.tmp
